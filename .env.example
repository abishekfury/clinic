# Copy to .env.local for local development; set the same names in Vercel. Never commit real values.

# Production URL of the n8n Webhook node (server-side only)
N8N_WEBHOOK_URL=
# Shared secret; n8n must check it against the "x-webhook-secret" header (server-side only)
N8N_WEBHOOK_SECRET=

# Optional: clinic phone shown as the fallback when a submission fails (public)
NEXT_PUBLIC_CLINIC_PHONE_DISPLAY=
